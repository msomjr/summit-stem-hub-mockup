# Copy this file to ".env" and fill in real values. Never commit ".env".

# A long random string used to sign admin session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# The origin your frontend is served from (browser security check).
# Use "*" only while testing locally.
FRONTEND_ORIGIN=http://localhost:5500

# --- Admin login (replaces the old hardcoded "1" / "1" bypass) ---
ADMIN_EMAIL=admin@summit.org

# Generate the hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourStrongPassword'))"
# Paste the full output (starts with "scrypt:" or "pbkdf2:") below. Never put
# the plain-text password here or anywhere else.
ADMIN_PASSWORD_HASH=
